{
  "name": "dsh-calorie-helper",
  "version": "0.2.5",
  "description": "DSH 卡路里记录",
  "repository": { "type": "git", "url": "https://github.com/Laucky67/DSH-CalorieHelper.git" },
  "type": "module",
  "main": "./lib/index.js",
  "bin": { "calorie-helper-data": "./scripts/data.mjs" },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "scripts/data.mjs", "skills/meal-logging"],
  "engines": { "node": ">=24.9.0", "dsh": "0.2.2-rc.5" },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm typecheck && pnpm test && pnpm build && node scripts/verify-package.mjs"
  },
  "dependencies": { "@deepseek-ai/dsh-home-paths": "0.2.2-rc.5", "yaml": "2.9.1", "zod": "4.6.6" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.5",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.5",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "~3.19.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.27.3",
    "typescript": "~5.9.3"
  }
}
